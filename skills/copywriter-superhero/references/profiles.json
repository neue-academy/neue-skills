{
  "_comment": [
    "Regime profiles: the discipline rulebook for each kind of copy.",
    "A 3-word button and a 4,000-word sales letter cannot be judged by the same numbers,",
    "so score_copy.py loads one profile per run and only the checks that regime declares.",
    "",
    "Severity per check: BLOCK (must fix), WARN (fix or justify), off (not scored here).",
    "",
    "voice_governs: when true and a brand codex is supplied, the codex's measured numbers",
    "override this profile's style gates. When false, the profile always wins, because",
    "clarity law outranks brand personality in UX and legal copy. Protected brand terms",
    "are honoured in every regime."
  ],
  "profiles": {
    "microcopy": {
      "label": "Microcopy / UX writing",
      "examples": "buttons, error messages, empty states, tooltips, form labels, confirmations, toasts",
      "word_range": [1, 15],
      "discipline": "NN/g 3 C's, applied in order: clarity, then concision, then character. Clever-but-unclear fails regardless of personality.",
      "voice_governs": false,
      "checks": {
        "banned-word": "BLOCK",
        "banned-construction": "BLOCK",
        "protected-overuse": "off",
        "sentence-length": "BLOCK",
        "flat-rhythm": "off",
        "no-short-sentences": "off",
        "low-specificity": "off",
        "hedging": "BLOCK",
        "adverbs": "WARN",
        "em-dash": "off",
        "passive": "BLOCK",
        "nominalization": "WARN",
        "reading-grade": "BLOCK",
        "missing-angle": "off",
        "angle-overlap": "off",
        "duplicate-line": "WARN",
        "repeated-opener": "off",
        "no-imperative-cta": "off",
        "capitalization": "WARN",
        "exclamation": "WARN",
        "missing-triage": "off",
        "missing-section": "off",
        "microcopy-item": "BLOCK"
      },
      "gates": {
        "max_mean_sentence_words": 12.0,
        "max_hedges_per_100": 0.0,
        "max_ly_adverbs_per_100": 2.0,
        "max_passive_hint_per_100": 1.0,
        "max_nominalizations_per_100": 3.0,
        "max_reading_grade": 8.0,
        "min_score_to_pass": 85
      },
      "microcopy_kinds": {
        "button": {
          "max_words": 4,
          "verb_first": true,
          "banned": ["submit", "click here", "learn more", "read more", "ok", "yes", "no", "continue?"],
          "note": "Name the outcome, not the mechanism. \"Create account\", never \"Submit\"."
        },
        "cta": { "max_words": 5, "verb_first": true, "banned": ["click here", "learn more"] },
        "link": { "max_words": 5, "verb_first": false, "banned": ["click here", "here", "read more"] },
        "error": {
          "max_words": 25,
          "require_fix": true,
          "banned": ["oops", "invalid", "error occurred", "something went wrong", "you did", "you didn't", "you failed", "you entered", "illegal", "forbidden"],
          "note": "[what went wrong] + [why, if known] + [how to fix it]. Never blame the reader."
        },
        "empty state": { "max_words": 25, "require_fix": true, "banned": ["nothing here", "no data"] },
        "tooltip": { "max_words": 12, "verb_first": false, "banned": [] },
        "label": { "max_words": 6, "verb_first": false, "banned": [] },
        "placeholder": { "max_words": 8, "verb_first": false, "banned": ["enter", "type here"] },
        "confirmation": { "max_words": 15, "verb_first": false, "banned": ["are you sure"] },
        "success": { "max_words": 15, "verb_first": false, "banned": [] },
        "toast": { "max_words": 15, "verb_first": false, "banned": [] }
      }
    },

    "short-form": {
      "label": "Short-form marketing copy",
      "examples": "ads, headlines, hero sections, social posts, short emails, product descriptions",
      "word_range": [15, 300],
      "discipline": "Classic direct response: AIDA, PAS, BAB, FAB, matched to reader awareness. Three angles per task so there is something to test.",
      "voice_governs": true,
      "checks": {
        "banned-word": "BLOCK",
        "banned-construction": "BLOCK",
        "protected-overuse": "WARN",
        "sentence-length": "BLOCK",
        "flat-rhythm": "BLOCK",
        "no-short-sentences": "WARN",
        "low-specificity": "BLOCK",
        "hedging": "WARN",
        "adverbs": "WARN",
        "em-dash": "WARN",
        "passive": "WARN",
        "nominalization": "off",
        "reading-grade": "off",
        "missing-angle": "BLOCK",
        "angle-overlap": "BLOCK",
        "duplicate-line": "BLOCK",
        "repeated-opener": "WARN",
        "no-imperative-cta": "WARN",
        "capitalization": "WARN",
        "exclamation": "WARN",
        "missing-triage": "WARN",
        "missing-section": "off",
        "microcopy-item": "off"
      },
      "gates": {
        "max_mean_sentence_words": 20.0,
        "min_sentence_words_cv": 0.5,
        "min_short_sentence_ratio": 0.1,
        "min_spec_tokens_per_100": 1.0,
        "max_hedges_per_100": 0.6,
        "max_ly_adverbs_per_100": 1.8,
        "max_em_dash_per_1000": 8.0,
        "max_passive_hint_per_100": 1.5,
        "max_protected_term_repeats": 2,
        "required_angles": ["logic", "pain", "social proof"],
        "max_angle_overlap": 0.5,
        "min_score_to_pass": 80
      }
    },

    "long-form": {
      "label": "Long-form persuasive copy",
      "examples": "sales pages, VSL scripts, long email sequences, webinar scripts, direct-mail letters",
      "word_range": [1500, 12000],
      "discipline": "Full persuasion architecture in fixed order. Required when price exceeds ~$100, traffic is cold, the product is complex, or the market is crowded.",
      "voice_governs": true,
      "checks": {
        "banned-word": "BLOCK",
        "banned-construction": "BLOCK",
        "protected-overuse": "WARN",
        "sentence-length": "BLOCK",
        "flat-rhythm": "BLOCK",
        "no-short-sentences": "WARN",
        "low-specificity": "BLOCK",
        "hedging": "WARN",
        "adverbs": "WARN",
        "em-dash": "WARN",
        "passive": "WARN",
        "nominalization": "off",
        "reading-grade": "WARN",
        "missing-angle": "off",
        "angle-overlap": "off",
        "duplicate-line": "WARN",
        "repeated-opener": "WARN",
        "no-imperative-cta": "BLOCK",
        "capitalization": "WARN",
        "exclamation": "WARN",
        "missing-triage": "WARN",
        "missing-section": "BLOCK",
        "microcopy-item": "off"
      },
      "gates": {
        "max_mean_sentence_words": 22.0,
        "min_sentence_words_cv": 0.5,
        "min_short_sentence_ratio": 0.1,
        "min_spec_tokens_per_100": 1.2,
        "max_hedges_per_100": 0.8,
        "max_ly_adverbs_per_100": 2.0,
        "max_em_dash_per_1000": 10.0,
        "max_passive_hint_per_100": 2.0,
        "max_protected_term_repeats": 2,
        "max_reading_grade": 10.0,
        "min_score_to_pass": 80,
        "required_sections": [
          { "name": "headline", "synonyms": ["headline", "hook line", "title"] },
          { "name": "hook", "synonyms": ["hook", "opening", "lead", "cold open"] },
          { "name": "problem", "synonyms": ["problem", "agitation", "agitate", "pain"] },
          { "name": "credibility", "synonyms": ["credibility", "credentials", "why listen", "who i am", "authority", "bridge"] },
          { "name": "mechanism", "synonyms": ["mechanism", "how it works", "the shift", "discovery", "solution"] },
          { "name": "proof", "synonyms": ["proof", "evidence", "testimony", "case study", "results"] },
          { "name": "offer", "synonyms": ["offer", "what you get", "pricing", "the deal"] },
          { "name": "guarantee", "synonyms": ["guarantee", "risk reversal", "refund", "warranty"] },
          { "name": "close", "synonyms": ["close", "call to action", "cta", "urgency", "next step"] },
          { "name": "postscript", "synonyms": ["postscript", "p.s.", "ps"] }
        ]
      }
    },

    "editorial": {
      "label": "Editorial and narrative",
      "examples": "books, chapters, screenplays, scripts, essays, newsletters as content, documentation prose, speeches",
      "word_range": [200, 100000],
      "discipline": "Structure by information reveal and scene, not persuasion. Rhythm and concrete detail carry the reader; there is no CTA to reach.",
      "voice_governs": true,
      "checks": {
        "banned-word": "WARN",
        "banned-construction": "WARN",
        "protected-overuse": "WARN",
        "sentence-length": "WARN",
        "flat-rhythm": "BLOCK",
        "no-short-sentences": "WARN",
        "low-specificity": "WARN",
        "hedging": "WARN",
        "adverbs": "BLOCK",
        "em-dash": "WARN",
        "passive": "WARN",
        "nominalization": "WARN",
        "reading-grade": "off",
        "missing-angle": "off",
        "angle-overlap": "off",
        "duplicate-line": "WARN",
        "repeated-opener": "BLOCK",
        "no-imperative-cta": "off",
        "capitalization": "off",
        "exclamation": "WARN",
        "missing-triage": "off",
        "missing-section": "off",
        "microcopy-item": "off"
      },
      "gates": {
        "max_mean_sentence_words": 26.0,
        "min_sentence_words_cv": 0.55,
        "min_short_sentence_ratio": 0.12,
        "min_spec_tokens_per_100": 0.3,
        "max_hedges_per_100": 1.2,
        "max_ly_adverbs_per_100": 1.6,
        "max_em_dash_per_1000": 12.0,
        "max_passive_hint_per_100": 2.5,
        "max_nominalizations_per_100": 6.0,
        "max_protected_term_repeats": 4,
        "min_score_to_pass": 80
      }
    },

    "functional": {
      "label": "Functional and legal",
      "examples": "terms of service, privacy policies, contracts, transactional email, policy docs, help articles, release notes",
      "word_range": [50, 50000],
      "discipline": "Plain-language law: precision first, navigability second, zero persuasion. Hedges like \"may\" and \"must\" are load-bearing here and are not scored.",
      "voice_governs": false,
      "checks": {
        "banned-word": "BLOCK",
        "banned-construction": "WARN",
        "protected-overuse": "off",
        "sentence-length": "BLOCK",
        "flat-rhythm": "off",
        "no-short-sentences": "off",
        "low-specificity": "WARN",
        "hedging": "off",
        "adverbs": "WARN",
        "em-dash": "WARN",
        "passive": "BLOCK",
        "nominalization": "BLOCK",
        "reading-grade": "BLOCK",
        "missing-angle": "off",
        "angle-overlap": "off",
        "duplicate-line": "WARN",
        "repeated-opener": "off",
        "no-imperative-cta": "off",
        "capitalization": "off",
        "exclamation": "BLOCK",
        "missing-triage": "off",
        "missing-section": "off",
        "microcopy-item": "off"
      },
      "gates": {
        "max_mean_sentence_words": 25.0,
        "min_spec_tokens_per_100": 0.5,
        "max_ly_adverbs_per_100": 1.5,
        "max_em_dash_per_1000": 6.0,
        "max_passive_hint_per_100": 2.0,
        "max_nominalizations_per_100": 4.0,
        "max_reading_grade": 12.0,
        "min_score_to_pass": 80
      },
      "extra_rule_tables": ["plain-language-table.md"]
    }
  }
}
