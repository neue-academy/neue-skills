# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Create a token at https://vercel.com/account/tokens
VERCEL_TOKEN=

# Vercel project to deploy into. Created on first deploy if it does not exist.
VERCEL_PROJECT=neue-landing

# Team slug, if the project belongs to a team rather than a personal account.
VERCEL_SCOPE=theneue-academy
